---
interface Props {
	title: string;
	institution: string;
	location: string;
	year: string;
}

const { title, institution, location, year } = Astro.props;
---

<div class="education-card">
	<div class="card-content">
		<div class="education-header">
			<div>
				<h4>{title}</h4>
				<p class="institution">{institution}</p>
			</div>
			<span class="year-badge">{year}</span>
		</div>
		<p class="location">{location}</p>
	</div>
</div>

<style>
	.education-card {
		padding: 1.75rem;
		margin-bottom: 1.25rem;
		background: var(--bg-secondary);
		border-radius: 12px;
		border-left: 5px solid var(--success);
		transition: var(--transition);
		box-shadow: var(--shadow-sm);
		position: relative;
		overflow: hidden;
	}

	.education-card::before {
		content: '';
		position: absolute;
		top: -50%;
		right: -50%;
		width: 200px;
		height: 200px;
		background: rgba(16, 185, 129, 0.05);
		border-radius: 50%;
		filter: blur(30px);
	}

	.education-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-left-color: var(--accent);
	}

	.card-content {
		flex: 1;
		position: relative;
		z-index: 1;
	}

	.education-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 0.75rem;
		gap: 1rem;
	}

	h4 {
		margin: 0 0 0.25rem 0;
		color: var(--text-primary);
		font-size: 1.15rem;
		font-weight: 700;
	}

	.institution {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.95rem;
		font-weight: 600;
	}

	.location {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.9rem;
	}

	.year-badge {
		background: var(--success);
		color: white;
		padding: 0.4rem 1rem;
		border-radius: 20px;
		font-size: 0.8rem;
		font-weight: 700;
		white-space: nowrap;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		box-shadow: var(--shadow-sm);
	}

	@media (max-width: 640px) {
		.education-card {
			flex-direction: column;
			gap: 1rem;
		}

		.card-icon {
			font-size: 2rem;
		}

		.education-header {
			flex-direction: column;
		}

		.year-badge {
			width: fit-content;
		}
	}
</style>
