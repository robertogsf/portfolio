---
import { SITE_TITLE, PERSONAL_INFO } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav class="navbar">
		<div class="nav-container">
			<h2 class="logo"><a href="/">{SITE_TITLE}</a></h2>
			<div class="nav-links">
				<div class="internal-links">
					<HeaderLink href="/">Inicio</HeaderLink>
					<HeaderLink href={PERSONAL_INFO.github} target="_blank">GitHub</HeaderLink>
					<HeaderLink href={PERSONAL_INFO.linkedin} target="_blank">LinkedIn</HeaderLink>
				</div>
				<ThemeToggle />
				<div class="social-links">
					<a href={PERSONAL_INFO.github} target="_blank" class="social-icon" title="GitHub">
						<span class="sr-only">GitHub</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
							><path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path></svg
						>
					</a>
					<a href={PERSONAL_INFO.linkedin} target="_blank" class="social-icon" title="LinkedIn">
						<span class="sr-only">LinkedIn</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
							><path
								fill="currentColor"
								d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
							></path></svg
						>
					</a>
				</div>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		background: var(--bg-primary);
		border-bottom: 1px solid var(--border-color);
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: var(--shadow-sm);
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}

	/* Force header colors to follow theme variables (global selector to avoid Astro scoping) */
	:global(html[data-theme="dark"] header) {
		background: var(--bg-primary);
		border-bottom-color: var(--border-color);
		color: var(--text-primary);
	}

	.navbar {
		padding: 0 1.5rem;
	}

	.nav-container {
		max-width: 1000px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem 0;
	}

	.logo {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.5px;
	}

	.logo a {
		background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		text-decoration: none;
		font-weight: 800;
		transition: var(--transition);
	}

	.logo a:hover {
		text-decoration: none;
		opacity: 0.8;
	}

	.nav-links {
		display: flex;
		gap: 2.5rem;
		align-items: center;
	}

	.internal-links {
		display: flex;
		gap: 2rem;
		align-items: center;
	}

	/* Ensure internal nav links have correct color and no default underline */
	.internal-links a {
		text-decoration: none;
		color: var(--text-primary);
		padding-bottom: 2px;
		transition: color 0.2s ease;
	}

	.internal-links a.active {
		text-decoration: none;
		border-bottom: 2px solid var(--primary);
		color: var(--primary);
		font-weight: 700;
	}

	/* Prevent global link hover underline from affecting header links */
	.internal-links a:hover,
	.nav-links a:hover {
		text-decoration: none;
		color: var(--primary);
	}

	/* Global overrides to avoid Astro CSS scoping issues */
	:global(.internal-links a) {
		text-decoration: none;
		color: var(--text-primary);
	}

	:global(.internal-links a.active) {
		text-decoration: none !important;
		color: var(--primary);
		font-weight: 700;
	}

	.social-links {
		display: flex;
		gap: 1.25rem;
		align-items: center;
		padding-left: 2rem;
		border-left: 1px solid var(--border-color);
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 8px;
		color: var(--text-secondary);
		background: var(--bg-secondary);
		transition: var(--transition);
	}

	.social-icon:hover {
		background: var(--primary-light);
		color: var(--primary);
		transform: translateY(-2px);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}

	@media (max-width: 768px) {
		.nav-container {
			flex-wrap: wrap;
			gap: 1rem;
		}

		.nav-links {
			gap: 1.5rem;
			flex-wrap: wrap;
			width: 100%;
			order: 3;
		}

		.internal-links {
			gap: 1rem;
		}

		.social-links {
			padding-left: 0;
			border-left: none;
		}

		.logo {
			font-size: 1.15rem;
		}
	}
</style>
